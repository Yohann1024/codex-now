#!/bin/bash

# Codex Now: open Terminal in the current Finder folder and run Codex CLI.

TARGET_DIR="$1"
LAST_DIR_FILE="$HOME/.codex-now-last-dir"
CODEX_COMMAND='codex --dangerously-bypass-approvals-and-sandbox'
LOG_DIR="$HOME/Library/Logs/Codex Now"
LOG_FILE="$LOG_DIR/launcher.log"
AUTO_CONFIRM_TIMEOUT="${CODEX_NOW_CONFIRM_TIMEOUT:-5}"
AUTO_CONFIRM_INTERVAL="${CODEX_NOW_CONFIRM_INTERVAL:-0.1}"

log() {
    mkdir -p "$LOG_DIR"
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

source_shell_config() {
    for config_file in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.bash_profile"; do
        if [ -f "$config_file" ]; then
            # shellcheck source=/dev/null
            source "$config_file" >/dev/null 2>&1 || true
        fi
    done

    export PATH="$HOME/.npm-global/bin:$HOME/.npm/bin:$HOME/Library/pnpm:$HOME/.yarn/bin:$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/local/share/npm/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

    if [ -d "$HOME/.nvm" ]; then
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
    fi
}

finder_front_directory() {
    osascript -e '
        tell application "Finder"
            set currentPath to ""
            try
                if (count of Finder windows) > 0 then
                    set currentPath to POSIX path of (target of front window as alias)
                end if
            end try
            if currentPath is "" then
                try
                    set currentPath to POSIX path of (insertion location as alias)
                end try
            end if
            return currentPath
        end tell
    ' 2>/dev/null
}

resolve_target_dir() {
    log "launch start: raw_arg=$TARGET_DIR"

    if [ -z "$TARGET_DIR" ]; then
        TARGET_DIR=$(finder_front_directory)
        log "finder front directory: $TARGET_DIR"
    fi

    if [ -z "$TARGET_DIR" ]; then
        log "error: could not determine Finder directory"
        osascript -e "display alert \"Codex Now Error\" message \"Could not determine the current Finder folder. Please open a Finder window in the target folder, then try again.\"" >/dev/null 2>&1 || true
        exit 1
    fi

    if [ ! -d "$TARGET_DIR" ]; then
        log "error: target directory does not exist: $TARGET_DIR"
        osascript -e "display alert \"Codex Now Error\" message \"Directory '$TARGET_DIR' does not exist.\"" >/dev/null 2>&1 || true
        exit 1
    fi

    printf '%s\n' "$TARGET_DIR" > "$LAST_DIR_FILE"
}

ensure_codex_exists() {
    if command -v codex >/dev/null 2>&1; then
        log "codex path: $(command -v codex)"
        return 0
    fi

    log "error: codex not found on PATH=$PATH"
    osascript -e "display alert \"Codex CLI Not Found\" message \"Could not find 'codex' on PATH. Please install Codex CLI or make sure your shell config exposes it.\"" >/dev/null 2>&1 || true
    exit 1
}

open_terminal_and_run_codex() {
    log "terminal command: cd '$TARGET_DIR' && $CODEX_COMMAND"
    log "auto confirm timeout: ${AUTO_CONFIRM_TIMEOUT}s interval: ${AUTO_CONFIRM_INTERVAL}s"
    local osascript_output
    osascript_output=$(osascript <<EOF2 2>&1
tell application "Terminal"
    activate
    set codexTab to do script "cd " & quoted form of "$TARGET_DIR" & " && $CODEX_COMMAND"
    set maxChecks to ($AUTO_CONFIRM_TIMEOUT / $AUTO_CONFIRM_INTERVAL) as integer
    set didConfirm to false
    repeat with checkIndex from 1 to maxChecks
        delay $AUTO_CONFIRM_INTERVAL
        set tabContents to contents of codexTab
        if tabContents contains "Do you trust" or tabContents contains "Yes, continue" then
            do script "1" in codexTab
            set didConfirm to true
            exit repeat
        end if
    end repeat
    if didConfirm then
        return "confirmed trust prompt"
    else
        return "trust prompt not detected"
    end if
end tell
EOF2
)
    local osascript_status=$?
    log "terminal confirm result: status=$osascript_status output=$osascript_output"
}

source_shell_config
resolve_target_dir
ensure_codex_exists
open_terminal_and_run_codex
